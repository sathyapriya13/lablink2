{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci --no-fund && npm --prefix frontend run build",
  "functions": {
    "app.py": {
      "includeFiles": "frontend/dist/**",
      "excludeFiles": "{backend/tests/**,frontend/src/**,frontend/node_modules/**,docs/**}",
      "maxDuration": 60
    }
  }
}
